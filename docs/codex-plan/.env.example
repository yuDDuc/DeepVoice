# AVRT Studio — Sao chép thành .env; tuyệt đối không commit .env hay token thật.
# Các ví dụ mặc định ưu tiên mock / CPU / không thu tiền thật.
# Có thể sửa mọi tham số cấu hình dưới đây; model/shape vẫn phải tương thích adapter.

# Tên ứng dụng; chuỗi; mặc định AVRT Studio; cần restart.
APP_NAME=AVRT Studio
# Môi trường: development|test|production; cần restart.
APP_ENV=development
# Mức log: DEBUG|INFO|WARNING|ERROR; mặc định INFO; restart.
LOG_LEVEL=INFO
# Host FastAPI; mặc định 0.0.0.0; restart.
API_HOST=0.0.0.0
# Cổng FastAPI, số nguyên; restart.
API_PORT=8000
# Cổng Next.js, số nguyên; restart.
WEB_PORT=3000
# Origin cho CORS/cookie; không đặt dấu / cuối; restart.
FRONTEND_ORIGIN=http://localhost:3000
# URL công khai tới API; dùng dev localhost; restart.
API_PUBLIC_URL=http://localhost:8000
# URL API frontend biết được (PUBLIC); restart/rebuild FE.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# URL WebSocket frontend (PUBLIC); production dùng wss; restart/rebuild FE.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1
# MongoDB URI, trong Docker dev dùng replica set rs0; secret prod; restart.
DATABASE_URL=mongodb://mongo:27017/?replicaSet=rs0
# Tên DB Mongo; restart.
DATABASE_NAME=avrt
# Tên replica set Mongo; phải khớp URI, restart.
MONGODB_REPLICA_SET=rs0
# Giới hạn transaction DB tính bằng ms; restart.
MONGODB_TX_TIMEOUT_MS=5000
# Kết nối Redis nội bộ; restart.
REDIS_URL=redis://redis:6379/0
# Thư mục upload audio tạm, tuyệt đối không public trực tiếp; restart.
LOCAL_STORAGE_ROOT=/data/uploads
# Thư mục gốc cho model tự train, mount volume; restart.
LOCAL_MODELS_ROOT=/models/custom
# Kích thước upload tối đa MB; restart.
MAX_UPLOAD_MB=100
# Giữ file upload tạm tối đa giờ; 0 là không lưu lâu; restart.
FILE_RETENTION_HOURS=24
# Cho phép lưu audio khi user đồng ý: true|false; mặc định false; restart.
ALLOW_RAW_AUDIO_RETENTION=false
# Cho phép memory giọng khi có consent: true|false; mặc định false; restart.
SPEAKER_MEMORY_ENABLED=false
# Thời hạn access token phút; restart.
ACCESS_TOKEN_MIN=15
# Thời hạn refresh token ngày; restart.
REFRESH_TOKEN_DAYS=14
# BÍ MẬT ký token; bắt buộc trong production; tự sinh dài ngẫu nhiên; restart.
JWT_SECRET=
# true khi HTTPS production; false chỉ dev localhost; restart.
COOKIE_SECURE=false
# Cookie SameSite lax|strict|none; none cần secure; restart.
COOKIE_SAMESITE=lax
# Bắt xác minh email trước đăng nhập: true|false; restart.
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Số lần login tối đa mỗi phút mỗi nguồn; restart.
AUTH_RATE_LIMIT_PER_MIN=10
# TTL vé WebSocket ngắn hạn tính bằng giây; restart.
WS_TICKET_TTL_SECONDS=60
# Cho phép đăng ký: true|false; restart.
ENABLE_REGISTRATION=true
# mock|smtp; mock chỉ dev; restart.
MAIL_PROVIDER=mock
# Host SMTP khi MAIL_PROVIDER=smtp; restart.
SMTP_HOST=
# Cổng SMTP; restart.
SMTP_PORT=587
# Tài khoản SMTP server-side; restart.
SMTP_USER=
# MẬT KHẨU SMTP server-side; restart.
SMTP_PASSWORD=
# Token HF server-side cho repo private hoặc remote API; để trống khi mock/public; restart.
HF_TOKEN=
# Thư mục cache Hugging Face trên volume; restart.
HF_HOME=/models/hf
# Chế độ offline HF 0|1; 1 không gọi Internet; restart.
HF_HUB_OFFLINE=0
# Timeout tải file HF giây; restart.
HF_HUB_DOWNLOAD_TIMEOUT=30
# Không thực thi Python từ repo model: false mặc định; true chỉ admin tin cậy; restart.
HF_ALLOW_TRUST_REMOTE_CODE=false
# Chỉ download model khi chọn/warmup, true|false; restart.
HF_DOWNLOAD_LAZY=true
# Production khuyến nghị true, yêu cầu SHA/revision cố định; restart.
HF_PIN_REVISION_REQUIRED=false
# Giới hạn dung lượng cache model GB; restart.
MODEL_MAX_CACHE_GB=16
# Số model tối đa giữ trong RAM/VRAM; restart.
MODEL_MAX_LOADED=2
# Timeout load model giây; restart.
MODEL_LOAD_TIMEOUT_S=180
# Timeout inference giây; restart.
MODEL_REQUEST_TIMEOUT_S=90
# Mặc định cpu|cuda|mps|auto; cần thiết bị hỗ trợ; restart.
MODEL_DEFAULT_DEVICE=cpu
# Kiểu tính mặc định float32|float16|bfloat16|auto; không phải model nào cũng hỗ trợ; restart.
MODEL_GLOBAL_DTYPE=float32
# GPU index danh sách phân tách dấu phẩy, ví dụ 0 hoặc 0,1; restart.
GPU_DEVICE_IDS=0
# Phần VRAM ngân sách tối đa 0..1; restart.
GPU_MEMORY_FRACTION=0.75
# Tùy chọn endpoint HF Inference custom; để trống dùng chính thức; restart.
HF_REMOTE_BASE_URL=
# Provider HF remote: auto hoặc tên provider được hỗ trợ; restart.
HF_REMOTE_PROVIDER=auto
# Thứ tự provider fallback ngăn bởi dấu phẩy; chỉ chọn role hợp lệ; restart.
MODEL_FALLBACK_ORDER=local,hf_remote

# ===== ASR_EN: Nhận dạng giọng tiếng Anh =====
# Nhận dạng giọng tiếng Anh: Nguồn mock|hf_hub|hf_remote|local; mock là mẫu không gọi AI; cần reload model/restart.
ASR_EN_SOURCE=mock
# Nhận dạng giọng tiếng Anh: Repo HF dạng org/name; dùng nếu hf_hub hoặc hf_remote; cần reload model/restart.
ASR_EN_MODEL_ID=
# Nhận dạng giọng tiếng Anh: Commit SHA/nhánh/tag HF; production nên pin SHA; cần reload model/restart.
ASR_EN_MODEL_REVISION=
# Nhận dạng giọng tiếng Anh: Đường dẫn model local nằm TRONG LOCAL_MODELS_ROOT; để trống nếu không dùng; cần reload model/restart.
ASR_EN_LOCAL_PATH=
# Nhận dạng giọng tiếng Anh: Adapter định dạng: mock|transformers_seq2seq|whisper|ct2|onnx|custom_manifest|... (phải được hỗ trợ); cần reload model/restart.
ASR_EN_ADAPTER=mock
# Nhận dạng giọng tiếng Anh: Runtime: auto|pytorch|onnxruntime|ct2|whisper_cpp|remote; phải tương thích adapter; cần reload model/restart.
ASR_EN_ENGINE=auto
# Nhận dạng giọng tiếng Anh: Loại nhiệm vụ model; mặc định asr; cần reload model/restart.
ASR_EN_TASK=asr
# Nhận dạng giọng tiếng Anh: Ngôn ngữ/nhiệm vụ của role; en là mặc định; cần reload model/restart.
ASR_EN_LANGUAGE=en
# Nhận dạng giọng tiếng Anh: cpu|cuda|mps|auto; auto dựa vào phần cứng; cần reload model/restart.
ASR_EN_DEVICE=auto
# Nhận dạng giọng tiếng Anh: auto|float32|float16|bfloat16; phải tương thích; cần reload model/restart.
ASR_EN_DTYPE=auto
# Nhận dạng giọng tiếng Anh: none|int8|int4|fp16; chỉ khi engine/model hỗ trợ; cần reload model/restart.
ASR_EN_QUANTIZATION=none
# Nhận dạng giọng tiếng Anh: auto|pcm16|float32_audio|text|token_ids|mel|custom; adapter validate; cần reload model/restart.
ASR_EN_INPUT_FORMAT=auto
# Nhận dạng giọng tiếng Anh: JSON shape dạng [-1,80,-1] hay [-1,-1]; [] = adapter tự suy ra; cần reload model/restart.
ASR_EN_INPUT_SHAPE=[]
# Nhận dạng giọng tiếng Anh: auto|text|tokens|audio_pcm|embedding|json; adapter validate; cần reload model/restart.
ASR_EN_OUTPUT_FORMAT=auto
# Nhận dạng giọng tiếng Anh: JSON shape output; [] = adapter tự suy ra và validate khi chạy; cần reload model/restart.
ASR_EN_OUTPUT_SHAPE=[]
# Nhận dạng giọng tiếng Anh: Hz, 0=không áp dụng; không tự sửa model weight; cần reload model/restart.
ASR_EN_INPUT_SAMPLE_RATE=16000
# Nhận dạng giọng tiếng Anh: Số kênh audio; 0=không áp dụng; adapter validate; cần reload model/restart.
ASR_EN_INPUT_CHANNELS=1
# Nhận dạng giọng tiếng Anh: Độ dài chunk tính ms; 0=adapter quyết định; cần reload model/restart.
ASR_EN_CHUNK_MS=500
# Nhận dạng giọng tiếng Anh: Độ chồng lấn audio ms; 0=không dùng; cần reload model/restart.
ASR_EN_STRIDE_MS=100
# Nhận dạng giọng tiếng Anh: Độ dài âm thanh tối đa mỗi lệnh giây; 0=không áp dụng; cần reload model/restart.
ASR_EN_MAX_INPUT_SECONDS=30
# Nhận dạng giọng tiếng Anh: Batch inference số nguyên >=1; restart hoặc reload model; cần reload model/restart.
ASR_EN_BATCH_SIZE=1
# Nhận dạng giọng tiếng Anh: JSON object tùy chọn cho adapter, ví dụ {"beam_size":2}; JSON hợp lệ; cần reload model/restart.
ASR_EN_ADAPTER_KWARGS_JSON={}

# ===== ASR_VI: Nhận dạng giọng tiếng Việt =====
# Nhận dạng giọng tiếng Việt: Nguồn mock|hf_hub|hf_remote|local; mock là mẫu không gọi AI; cần reload model/restart.
ASR_VI_SOURCE=mock
# Nhận dạng giọng tiếng Việt: Repo HF dạng org/name; dùng nếu hf_hub hoặc hf_remote; cần reload model/restart.
ASR_VI_MODEL_ID=
# Nhận dạng giọng tiếng Việt: Commit SHA/nhánh/tag HF; production nên pin SHA; cần reload model/restart.
ASR_VI_MODEL_REVISION=
# Nhận dạng giọng tiếng Việt: Đường dẫn model local nằm TRONG LOCAL_MODELS_ROOT; để trống nếu không dùng; cần reload model/restart.
ASR_VI_LOCAL_PATH=
# Nhận dạng giọng tiếng Việt: Adapter định dạng: mock|transformers_seq2seq|whisper|ct2|onnx|custom_manifest|... (phải được hỗ trợ); cần reload model/restart.
ASR_VI_ADAPTER=mock
# Nhận dạng giọng tiếng Việt: Runtime: auto|pytorch|onnxruntime|ct2|whisper_cpp|remote; phải tương thích adapter; cần reload model/restart.
ASR_VI_ENGINE=auto
# Nhận dạng giọng tiếng Việt: Loại nhiệm vụ model; mặc định asr; cần reload model/restart.
ASR_VI_TASK=asr
# Nhận dạng giọng tiếng Việt: Ngôn ngữ/nhiệm vụ của role; vi là mặc định; cần reload model/restart.
ASR_VI_LANGUAGE=vi
# Nhận dạng giọng tiếng Việt: cpu|cuda|mps|auto; auto dựa vào phần cứng; cần reload model/restart.
ASR_VI_DEVICE=auto
# Nhận dạng giọng tiếng Việt: auto|float32|float16|bfloat16; phải tương thích; cần reload model/restart.
ASR_VI_DTYPE=auto
# Nhận dạng giọng tiếng Việt: none|int8|int4|fp16; chỉ khi engine/model hỗ trợ; cần reload model/restart.
ASR_VI_QUANTIZATION=none
# Nhận dạng giọng tiếng Việt: auto|pcm16|float32_audio|text|token_ids|mel|custom; adapter validate; cần reload model/restart.
ASR_VI_INPUT_FORMAT=auto
# Nhận dạng giọng tiếng Việt: JSON shape dạng [-1,80,-1] hay [-1,-1]; [] = adapter tự suy ra; cần reload model/restart.
ASR_VI_INPUT_SHAPE=[]
# Nhận dạng giọng tiếng Việt: auto|text|tokens|audio_pcm|embedding|json; adapter validate; cần reload model/restart.
ASR_VI_OUTPUT_FORMAT=auto
# Nhận dạng giọng tiếng Việt: JSON shape output; [] = adapter tự suy ra và validate khi chạy; cần reload model/restart.
ASR_VI_OUTPUT_SHAPE=[]
# Nhận dạng giọng tiếng Việt: Hz, 0=không áp dụng; không tự sửa model weight; cần reload model/restart.
ASR_VI_INPUT_SAMPLE_RATE=16000
# Nhận dạng giọng tiếng Việt: Số kênh audio; 0=không áp dụng; adapter validate; cần reload model/restart.
ASR_VI_INPUT_CHANNELS=1
# Nhận dạng giọng tiếng Việt: Độ dài chunk tính ms; 0=adapter quyết định; cần reload model/restart.
ASR_VI_CHUNK_MS=500
# Nhận dạng giọng tiếng Việt: Độ chồng lấn audio ms; 0=không dùng; cần reload model/restart.
ASR_VI_STRIDE_MS=100
# Nhận dạng giọng tiếng Việt: Độ dài âm thanh tối đa mỗi lệnh giây; 0=không áp dụng; cần reload model/restart.
ASR_VI_MAX_INPUT_SECONDS=30
# Nhận dạng giọng tiếng Việt: Batch inference số nguyên >=1; restart hoặc reload model; cần reload model/restart.
ASR_VI_BATCH_SIZE=1
# Nhận dạng giọng tiếng Việt: JSON object tùy chọn cho adapter, ví dụ {"beam_size":2}; JSON hợp lệ; cần reload model/restart.
ASR_VI_ADAPTER_KWARGS_JSON={}

# ===== MT_EN_VI: Dịch Anh sang Việt =====
# Dịch Anh sang Việt: Nguồn mock|hf_hub|hf_remote|local; mock là mẫu không gọi AI; cần reload model/restart.
MT_EN_VI_SOURCE=mock
# Dịch Anh sang Việt: Repo HF dạng org/name; dùng nếu hf_hub hoặc hf_remote; cần reload model/restart.
MT_EN_VI_MODEL_ID=
# Dịch Anh sang Việt: Commit SHA/nhánh/tag HF; production nên pin SHA; cần reload model/restart.
MT_EN_VI_MODEL_REVISION=
# Dịch Anh sang Việt: Đường dẫn model local nằm TRONG LOCAL_MODELS_ROOT; để trống nếu không dùng; cần reload model/restart.
MT_EN_VI_LOCAL_PATH=
# Dịch Anh sang Việt: Adapter định dạng: mock|transformers_seq2seq|whisper|ct2|onnx|custom_manifest|... (phải được hỗ trợ); cần reload model/restart.
MT_EN_VI_ADAPTER=mock
# Dịch Anh sang Việt: Runtime: auto|pytorch|onnxruntime|ct2|whisper_cpp|remote; phải tương thích adapter; cần reload model/restart.
MT_EN_VI_ENGINE=auto
# Dịch Anh sang Việt: Loại nhiệm vụ model; mặc định mt; cần reload model/restart.
MT_EN_VI_TASK=mt
# Dịch Anh sang Việt: Ngôn ngữ/nhiệm vụ của role; en-vi là mặc định; cần reload model/restart.
MT_EN_VI_LANGUAGE=en-vi
# Dịch Anh sang Việt: cpu|cuda|mps|auto; auto dựa vào phần cứng; cần reload model/restart.
MT_EN_VI_DEVICE=auto
# Dịch Anh sang Việt: auto|float32|float16|bfloat16; phải tương thích; cần reload model/restart.
MT_EN_VI_DTYPE=auto
# Dịch Anh sang Việt: none|int8|int4|fp16; chỉ khi engine/model hỗ trợ; cần reload model/restart.
MT_EN_VI_QUANTIZATION=none
# Dịch Anh sang Việt: auto|pcm16|float32_audio|text|token_ids|mel|custom; adapter validate; cần reload model/restart.
MT_EN_VI_INPUT_FORMAT=auto
# Dịch Anh sang Việt: JSON shape dạng [-1,80,-1] hay [-1,-1]; [] = adapter tự suy ra; cần reload model/restart.
MT_EN_VI_INPUT_SHAPE=[]
# Dịch Anh sang Việt: auto|text|tokens|audio_pcm|embedding|json; adapter validate; cần reload model/restart.
MT_EN_VI_OUTPUT_FORMAT=auto
# Dịch Anh sang Việt: JSON shape output; [] = adapter tự suy ra và validate khi chạy; cần reload model/restart.
MT_EN_VI_OUTPUT_SHAPE=[]
# Dịch Anh sang Việt: Hz, 0=không áp dụng; không tự sửa model weight; cần reload model/restart.
MT_EN_VI_INPUT_SAMPLE_RATE=0
# Dịch Anh sang Việt: Số kênh audio; 0=không áp dụng; adapter validate; cần reload model/restart.
MT_EN_VI_INPUT_CHANNELS=0
# Dịch Anh sang Việt: Độ dài chunk tính ms; 0=adapter quyết định; cần reload model/restart.
MT_EN_VI_CHUNK_MS=0
# Dịch Anh sang Việt: Độ chồng lấn audio ms; 0=không dùng; cần reload model/restart.
MT_EN_VI_STRIDE_MS=0
# Dịch Anh sang Việt: Độ dài âm thanh tối đa mỗi lệnh giây; 0=không áp dụng; cần reload model/restart.
MT_EN_VI_MAX_INPUT_SECONDS=0
# Dịch Anh sang Việt: Batch inference số nguyên >=1; restart hoặc reload model; cần reload model/restart.
MT_EN_VI_BATCH_SIZE=1
# Dịch Anh sang Việt: JSON object tùy chọn cho adapter, ví dụ {"beam_size":2}; JSON hợp lệ; cần reload model/restart.
MT_EN_VI_ADAPTER_KWARGS_JSON={}

# ===== MT_VI_EN: Dịch Việt sang Anh =====
# Dịch Việt sang Anh: Nguồn mock|hf_hub|hf_remote|local; mock là mẫu không gọi AI; cần reload model/restart.
MT_VI_EN_SOURCE=mock
# Dịch Việt sang Anh: Repo HF dạng org/name; dùng nếu hf_hub hoặc hf_remote; cần reload model/restart.
MT_VI_EN_MODEL_ID=
# Dịch Việt sang Anh: Commit SHA/nhánh/tag HF; production nên pin SHA; cần reload model/restart.
MT_VI_EN_MODEL_REVISION=
# Dịch Việt sang Anh: Đường dẫn model local nằm TRONG LOCAL_MODELS_ROOT; để trống nếu không dùng; cần reload model/restart.
MT_VI_EN_LOCAL_PATH=
# Dịch Việt sang Anh: Adapter định dạng: mock|transformers_seq2seq|whisper|ct2|onnx|custom_manifest|... (phải được hỗ trợ); cần reload model/restart.
