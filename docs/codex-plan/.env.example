# ==== STREAMING / VERIFICATION / ADAPTATION ====
# Audio mic streaming Hz; input có thể resample phù hợp ASR; restart.
STREAM_AUDIO_SAMPLE_RATE=16000
# Số kênh mic; mặc định mono; restart.
STREAM_AUDIO_CHANNELS=1
# Kích thước frame client gửi ms; 20..1000 tùy profile; restart.
STREAM_FRAME_MS=100
# Bộ đệm tối đa theo ms để chống nghẽn; restart.
STREAM_BUFFER_MAX_MS=10000
# Số phiên streaming đồng thời mỗi user; restart.
STREAM_MAX_SESSIONS_PER_USER=2
# Hết hạn phiên stream giây; restart.
STREAM_SESSION_TIMEOUT_S=1800
# Bật VAD true|false; restart.
VAD_ENABLED=true
# Đợi khoảng im lặng ms trước chốt câu; restart.
VAD_SILENCE_MS=650
# Số chunk đồng ý để chốt stable prefix; restart.
ASR_STABILITY_MIN_CHUNKS=2
# Kiểm tra số/phủ định/đơn vị/tên riêng trước xác nhận; restart.
VERIFY_FAST_ENABLED=true
# Bật semantic verifier khi VERIFIER_SOURCE khác mock/đã kiểm định; restart.
VERIFY_DEEP_ENABLED=false
# Dự đoán câu để prefetch; không đọc dự đoán chưa xác nhận; restart.
PREDICTIVE_ENABLED=false
# Số token nguồn tối thiểu trước khi cho dự đoán (nếu hỗ trợ); restart.
PREDICTIVE_WAIT_K=3
# Đợi linh động theo rủi ro và ngữ cảnh; restart.
ADAPTIVE_LATENCY_ENABLED=false
# Hỗ trợ trộn EN/VI khi adapter hỗ trợ; restart.
CODE_SWITCH_ENABLED=false
# Tự xác định chiều dịch nếu có model phù hợp; restart.
AUTO_LANGUAGE_ID_ENABLED=false
# Cho phép cloud khi user đã đồng ý và đã cấu hình; restart.
HYBRID_CLOUD_ENABLED=false
# Chỉ TTS phần confirmed; khuyến nghị luôn true; restart.
TTS_REQUIRE_CONFIRMED=true
# Chu kỳ đo CPU/GPU bằng ms; tránh quá dày; restart.
TELEMETRY_SAMPLE_MS=1000
# Cửa sổ tính P50/P95 tính giây; restart.
TELEMETRY_WINDOW_S=60
# Số ngày lưu metrics dạng tối giản; restart.
METRICS_RETENTION_DAYS=7
# Tự thử NVIDIA NVML, nếu không có trả unavailable; restart.
NVML_ENABLED=true
# Bật exporter quản trị với auth/firewall; restart.
PROMETHEUS_METRICS_ENABLED=false

# ==== BILLING / QR / PAYMENTS ====
# Bật giao diện/billing mock; true|false; restart.
BILLING_ENABLED=true
# mock|payos|sepay|google_pay_psp; mock không thu tiền; restart.
PAYMENT_PROVIDER=mock
# true = chỉ test khi provider hỗ trợ; production chuyển false sau xác minh; restart.
PAYMENT_TEST_MODE=true
# Đồng tiền: VND, amount phải số nguyên; restart.
PAYMENT_CURRENCY=VND
# Thời hạn QR/order phút; restart.
PAYMENT_ORDER_EXPIRY_MIN=15
# HTTPS công khai của backend nhận webhook provider; restart.
PAYMENT_WEBHOOK_PUBLIC_BASE_URL=
# TTL lưu idempotency request giờ; restart.
PAYMENT_IDEMPOTENCY_TTL_HOURS=72
# Credit thử nghiệm/tháng; server cấu hình; restart.
PLAN_FREE_MONTHLY_CREDITS=10
# Giá gói thử nghiệm (VND) là ví dụ không cam kết; restart.
PLAN_PRO_PRICE_VND=149000
# Credit gói Pro ví dụ; thay theo unit economics; restart.
PLAN_PRO_MONTHLY_CREDITS=100
# Giá gói credit nạp thêm ví dụ, VND; restart.
CREDIT_PACKAGE_PRICE_VND=50000
# Số credits cho gói nạp ví dụ; restart.
CREDIT_PACKAGE_UNITS=50
# BÍ MẬT/client ID do payOS cấp, server-side; restart.
PAYOS_CLIENT_ID=
# BÍ MẬT API payOS, server-side; restart.
PAYOS_API_KEY=
# BÍ MẬT ký webhook HMAC của payOS, server-side; restart.
PAYOS_CHECKSUM_KEY=
# BÍ MẬT xác minh webhook SePay theo mode chọn; restart.
SEPAY_WEBHOOK_SECRET=
# hmac|api_key|oauth tùy tài khoản/provider; restart.
SEPAY_AUTH_MODE=hmac
# BÍ MẬT server-side SePay nếu cần; restart.
SEPAY_API_KEY=
# Mã BIN ngân hàng nhận tiền, do nhà cung cấp QR hỗ trợ; restart.
VIETQR_BANK_BIN=
# Số tài khoản nhận tiền, server-side; công khai tới user trên QR; restart.
VIETQR_ACCOUNT_NUMBER=
# Tên người thụ hưởng hiển thị trên QR; restart.
VIETQR_ACCOUNT_NAME=
# Tiền tố nội dung chuyển khoản; thêm ref duy nhất mỗi đơn; restart.
VIETQR_TRANSFER_PREFIX=AVRT
# Chỉ true khi có PSP được hỗ trợ, xác nhận merchant đủ điều kiện; restart.
GOOGLE_PAY_ENABLED=false
# TEST|PRODUCTION, phải tuân thủ API merchant; restart.
GOOGLE_PAY_ENVIRONMENT=TEST
# Merchant Google Pay hợp lệ nếu được cấp; restart.
GOOGLE_PAY_MERCHANT_ID=
# Tên PSP được Google Pay hỗ trợ, cần cấu hình; restart.
GOOGLE_PAY_GATEWAY_NAME=
# Merchant ID tại PSP, server/client tokenization theo provider; restart.
GOOGLE_PAY_GATEWAY_MERCHANT_ID=
# BÍ MẬT PSP xử lý thanh toán, tuyệt đối không đưa frontend; restart.
GOOGLE_PAY_PSP_SECRET=
# Chu kỳ worker đối soát pending payment phút; restart.
PAYMENT_RECONCILE_INTERVAL_MIN=15
