# Dịch Việt sang Anh: Runtime: auto|pytorch|onnxruntime|ct2|whisper_cpp|remote; phải tương thích adapter; cần reload model/restart.
MT_VI_EN_ENGINE=auto
# Dịch Việt sang Anh: Loại nhiệm vụ model; mặc định mt; cần reload model/restart.
MT_VI_EN_TASK=mt
# Dịch Việt sang Anh: Ngôn ngữ/nhiệm vụ của role; vi-en là mặc định; cần reload model/restart.
MT_VI_EN_LANGUAGE=vi-en
# Dịch Việt sang Anh: cpu|cuda|mps|auto; auto dựa vào phần cứng; cần reload model/restart.
MT_VI_EN_DEVICE=auto
# Dịch Việt sang Anh: auto|float32|float16|bfloat16; phải tương thích; cần reload model/restart.
MT_VI_EN_DTYPE=auto
# Dịch Việt sang Anh: none|int8|int4|fp16; chỉ khi engine/model hỗ trợ; cần reload model/restart.
MT_VI_EN_QUANTIZATION=none
# Dịch Việt sang Anh: auto|pcm16|float32_audio|text|token_ids|mel|custom; adapter validate; cần reload model/restart.
MT_VI_EN_INPUT_FORMAT=auto
# Dịch Việt sang Anh: JSON shape dạng [-1,80,-1] hay [-1,-1]; [] = adapter tự suy ra; cần reload model/restart.
MT_VI_EN_INPUT_SHAPE=[]
# Dịch Việt sang Anh: auto|text|tokens|audio_pcm|embedding|json; adapter validate; cần reload model/restart.
MT_VI_EN_OUTPUT_FORMAT=auto
# Dịch Việt sang Anh: JSON shape output; [] = adapter tự suy ra và validate khi chạy; cần reload model/restart.
MT_VI_EN_OUTPUT_SHAPE=[]
# Dịch Việt sang Anh: Hz, 0=không áp dụng; không tự sửa model weight; cần reload model/restart.
MT_VI_EN_INPUT_SAMPLE_RATE=0
# Dịch Việt sang Anh: Số kênh audio; 0=không áp dụng; adapter validate; cần reload model/restart.
MT_VI_EN_INPUT_CHANNELS=0
# Dịch Việt sang Anh: Độ dài chunk tính ms; 0=adapter quyết định; cần reload model/restart.
MT_VI_EN_CHUNK_MS=0
# Dịch Việt sang Anh: Độ chồng lấn audio ms; 0=không dùng; cần reload model/restart.
MT_VI_EN_STRIDE_MS=0
# Dịch Việt sang Anh: Độ dài âm thanh tối đa mỗi lệnh giây; 0=không áp dụng; cần reload model/restart.
MT_VI_EN_MAX_INPUT_SECONDS=0
# Dịch Việt sang Anh: Batch inference số nguyên >=1; restart hoặc reload model; cần reload model/restart.
MT_VI_EN_BATCH_SIZE=1
