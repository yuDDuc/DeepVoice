# AVRT Studio 0.1: catalog các biến đã triển khai. Mọi thay đổi cần restart; NEXT_PUBLIC_* cần rebuild FE.
# Catalog kế hoạch đầy đủ nằm trong docs/codex-plan/.env.example, không dùng catalog đó làm .env runtime.

# Môi trường development|test|production; mặc định development; restart.
APP_ENV=development
# Cấu hình APP_NAME; mặc định AVRT Studio; kiểu str; restart.
APP_NAME=AVRT Studio
# Cấu hình API_PORT; mặc định 8000; kiểu int; restart.
API_PORT=8000
# Cấu hình WEB_PORT; mặc định 3000; kiểu int; restart.
WEB_PORT=3000
# Cấu hình NEXT_PUBLIC_API_BASE_URL; mặc định /api/v1; kiểu str; restart/rebuild FE.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Cấu hình NEXT_PUBLIC_WS_URL; mặc định /ws/v1; kiểu str; restart/rebuild FE.
NEXT_PUBLIC_WS_URL=/ws/v1
# Cấu hình FRONTEND_ORIGIN; mặc định http://localhost:3000; kiểu str; restart.
FRONTEND_ORIGIN=http://localhost:3000
# Cấu hình DATABASE_MODE; mongo/sqlite lưu bền; memory chỉ test/tạm thời; restart.
DATABASE_MODE=mongo
# File SQLite khi chạy local; đường dẫn tương đối tính từ gốc dự án; restart.
SQLITE_PATH=./data/avrt.sqlite3
# Cấu hình DATABASE_URL; mặc định mongodb://mongo:27017/?replicaSet=rs0; kiểu str; restart.
DATABASE_URL=mongodb://mongo:27017/?replicaSet=rs0
# Cấu hình DATABASE_NAME; mặc định avrt; kiểu str; restart.
DATABASE_NAME=avrt
# Cấu hình REDIS_URL; mặc định redis://redis:6379/0; kiểu str; restart.
REDIS_URL=redis://redis:6379/0
# redis chạy worker riêng; inline chỉ dev/test và không cách ly model; restart.
INFERENCE_MODE=redis
# Bí mật ký JWT tối thiểu 32 ký tự; để trống chỉ dev, tự sinh khi boot; restart.
JWT_SECRET=
# true khi HTTPS; false chỉ localhost dev; restart.
COOKIE_SECURE=false
# Cấu hình ACCESS_TOKEN_MIN; mặc định 15; kiểu int; restart.
ACCESS_TOKEN_MIN=15
# Cấu hình REFRESH_TOKEN_DAYS; mặc định 14; kiểu int; restart.
REFRESH_TOKEN_DAYS=14
# Cấu hình WS_TICKET_TTL_SECONDS; mặc định 30; kiểu int; restart.
WS_TICKET_TTL_SECONDS=30
# Cấu hình AUTH_RATE_LIMIT_PER_MIN; mặc định 10; kiểu int; restart.
AUTH_RATE_LIMIT_PER_MIN=10
# Cấu hình ENABLE_REGISTRATION; mặc định true; kiểu bool; restart.
ENABLE_REGISTRATION=true
# Gốc model tự train; Docker override /models/custom; restart.
LOCAL_MODELS_ROOT=./models/custom
# Thư mục cache trọng số; Docker override /models/cache; restart.
HF_CACHE_DIR=./models/cache
# Token HF bí mật phía server; để trống cho public Hub, Remote yêu cầu token; restart.
HF_TOKEN=
# true chỉ dùng cache, chặn HF Remote; false cho phép tải từ Hub; restart.
HF_OFFLINE=false
# Cấu hình HF_REMOTE_PROVIDER; mặc định hf-inference; kiểu str; restart.
HF_REMOTE_PROVIDER=hf-inference
# Cấu hình MODEL_MAX_NEW_TOKENS; mặc định 128; kiểu int; restart.
MODEL_MAX_NEW_TOKENS=128
# Cấu hình MAX_TEXT_CHARS; mặc định 4000; kiểu int; restart.
MAX_TEXT_CHARS=4000
# Cấu hình MAX_UPLOAD_MB; mặc định 10; kiểu int; restart.
MAX_UPLOAD_MB=10
# Giới hạn thời lượng riêng cho upload audio, 1–300 giây; mặc định 60; restart.
MAX_UPLOAD_AUDIO_SECONDS=120
# Cấu hình STREAM_AUDIO_SAMPLE_RATE; mặc định 16000; kiểu int; restart.
STREAM_AUDIO_SAMPLE_RATE=16000
# Cấu hình STREAM_FRAME_MS; mặc định 100; kiểu int; restart.
STREAM_FRAME_MS=100
# Giới hạn buffer mỗi phiên streaming theo ms; số 500–30000, mặc định 8000; restart.
STREAM_BUFFER_MAX_MS=8000
# Cấu hình STREAM_SESSION_TIMEOUT_S; mặc định 1800; kiểu int; restart.
STREAM_SESSION_TIMEOUT_S=1800
# Cấu hình STREAM_MAX_SESSIONS_PER_USER; mặc định 2; kiểu int; restart.
STREAM_MAX_SESSIONS_PER_USER=2
# Cấu hình VAD_SILENCE_MS; mặc định 650; kiểu int; restart.
VAD_SILENCE_MS=650
# Cấu hình VAD_RMS_THRESHOLD; mặc định 0.012; kiểu float; restart.
VAD_RMS_THRESHOLD=0.012
# Cấu hình TELEMETRY_SAMPLE_MS; mặc định 1000; kiểu int; restart.
TELEMETRY_SAMPLE_MS=1000
# Cấu hình TELEMETRY_WINDOW_S; mặc định 60; kiểu int; restart.
TELEMETRY_WINDOW_S=60
# true đo GPU NVIDIA nếu có NVML; không có trả null, không giả lập; restart.
NVML_ENABLED=true
# Cấu hình JOB_TIMEOUT_S; mặc định 120; kiểu int; restart.
JOB_TIMEOUT_S=120
# Cấu hình QUEUE_MAX_JOBS; mặc định 20; kiểu int; restart.
QUEUE_MAX_JOBS=20
# Cấu hình JOB_RESULT_TTL_S; mặc định 300; kiểu int; restart.
JOB_RESULT_TTL_S=300
# mock không thu tiền thật | payos cần merchant và webhook HTTPS; restart.
PAYMENT_PROVIDER=mock
# true cho phép mô phỏng ở dev/mock; không biến payOS thành sandbox; restart.
PAYMENT_TEST_MODE=true
# Cấu hình PAYMENT_ORDER_EXPIRY_MIN; mặc định 15; kiểu int; restart.
PAYMENT_ORDER_EXPIRY_MIN=15
# Cấu hình CREDIT_PACKAGE_PRICE_VND; mặc định 50000; kiểu int; restart.
CREDIT_PACKAGE_PRICE_VND=50000
# Cấu hình CREDIT_PACKAGE_UNITS; mặc định 50; kiểu int; restart.
CREDIT_PACKAGE_UNITS=50
# Cấu hình PAYOS_CLIENT_ID; mặc định ; kiểu str; restart.
PAYOS_CLIENT_ID=
# Cấu hình PAYOS_API_KEY; mặc định ; kiểu str; restart.
PAYOS_API_KEY=
# Cấu hình PAYOS_CHECKSUM_KEY; mặc định ; kiểu str; restart.
PAYOS_CHECKSUM_KEY=
# Cấu hình PAYOS_API_URL; mặc định https://api-merchant.payos.vn; kiểu str; restart.
PAYOS_API_URL=https://api-merchant.payos.vn
# Cấu hình PAYMENT_RETURN_URL; mặc định http://localhost:3000/app/billing; kiểu str; restart.
PAYMENT_RETURN_URL=http://localhost:3000/app/billing
# Cấu hình PAYMENT_CANCEL_URL; mặc định http://localhost:3000/app/billing; kiểu str; restart.
PAYMENT_CANCEL_URL=http://localhost:3000/app/billing
# TTL bản dịch đã cho phép lưu, ngày 1–365; mặc định 30; restart.
TRANSCRIPT_RETENTION_DAYS=30
# Nguồn mock|hf_hub|hf_remote|local; mock chỉ minh họa; restart.
ASR_EN_SOURCE=mock
# Repo HF hoặc HF endpoint đã được hỗ trợ; trống khi mock/local; restart.
ASR_EN_MODEL_ID=
# Commit hash/tag HF; nên pin commit để tái lập, trống dùng mặc định repo; restart.
ASR_EN_MODEL_REVISION=
# Đường dẫn tương đối trong LOCAL_MODELS_ROOT; không chấp nhận thoát thư mục gốc; restart.
ASR_EN_LOCAL_PATH=
# mock|transformers_asr|seq2seq|transformers_tts; chọn đúng vai trò và format; restart.
ASR_EN_ADAPTER=mock
# cpu|cuda|auto; cpu mặc định, cuda yêu cầu GPU khả dụng; restart.
ASR_EN_DEVICE=cpu
# float32|float16|bfloat16; mặc định float32, kiểm tra tương thích thiết bị; restart.
ASR_EN_DTYPE=float32
# JSON shape; -1 chiều động; ASR [-1], MT [-1,-1] token IDs; không resize kiến trúc; restart.
ASR_EN_INPUT_SHAPE=[-1]
# JSON shape khai báo output; -1 chiều động; MT kiểm tra token IDs trước decode; restart.
ASR_EN_OUTPUT_SHAPE=[-1]
# Sample rate audio Hz 8000–96000; ASR dùng để resample đầu vào; restart.
ASR_EN_INPUT_SAMPLE_RATE=16000
# Số kênh audio; chỉ hỗ trợ mono=1; restart.
ASR_EN_INPUT_CHANNELS=1
# JSON allowlist: max_new_tokens,num_beams,language,task,src_lang,tgt_lang; tùy adapter; restart.
ASR_EN_ADAPTER_KWARGS_JSON={}
# Prefix văn bản đầu vào cho seq2seq, ví dụ translate English to Vietnamese: ; theo model card; restart.
ASR_EN_PREFIX=
# Nguồn mock|hf_hub|hf_remote|local; mock chỉ minh họa; restart.
ASR_VI_SOURCE=mock
# Repo HF hoặc HF endpoint đã được hỗ trợ; trống khi mock/local; restart.
ASR_VI_MODEL_ID=
# Commit hash/tag HF; nên pin commit để tái lập, trống dùng mặc định repo; restart.
ASR_VI_MODEL_REVISION=
# Đường dẫn tương đối trong LOCAL_MODELS_ROOT; không chấp nhận thoát thư mục gốc; restart.
ASR_VI_LOCAL_PATH=
# mock|transformers_asr|seq2seq|transformers_tts; chọn đúng vai trò và format; restart.
ASR_VI_ADAPTER=mock
# cpu|cuda|auto; cpu mặc định, cuda yêu cầu GPU khả dụng; restart.
ASR_VI_DEVICE=cpu
# float32|float16|bfloat16; mặc định float32, kiểm tra tương thích thiết bị; restart.
ASR_VI_DTYPE=float32
# JSON shape; -1 chiều động; ASR [-1], MT [-1,-1] token IDs; không resize kiến trúc; restart.
ASR_VI_INPUT_SHAPE=[-1]
# JSON shape khai báo output; -1 chiều động; MT kiểm tra token IDs trước decode; restart.
ASR_VI_OUTPUT_SHAPE=[-1]
# Sample rate audio Hz 8000–96000; ASR dùng để resample đầu vào; restart.
ASR_VI_INPUT_SAMPLE_RATE=16000
# Số kênh audio; chỉ hỗ trợ mono=1; restart.
ASR_VI_INPUT_CHANNELS=1
# JSON allowlist: max_new_tokens,num_beams,language,task,src_lang,tgt_lang; tùy adapter; restart.
ASR_VI_ADAPTER_KWARGS_JSON={}
# Prefix văn bản đầu vào cho seq2seq, ví dụ translate English to Vietnamese: ; theo model card; restart.
ASR_VI_PREFIX=
# Nguồn mock|hf_hub|hf_remote|local; mock chỉ minh họa; restart.
MT_EN_VI_SOURCE=mock
# Repo HF hoặc HF endpoint đã được hỗ trợ; trống khi mock/local; restart.
MT_EN_VI_MODEL_ID=
# Commit hash/tag HF; nên pin commit để tái lập, trống dùng mặc định repo; restart.
MT_EN_VI_MODEL_REVISION=
# Đường dẫn tương đối trong LOCAL_MODELS_ROOT; không chấp nhận thoát thư mục gốc; restart.
MT_EN_VI_LOCAL_PATH=
