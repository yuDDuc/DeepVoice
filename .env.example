# JSON allowlist: max_new_tokens,num_beams,language,task,src_lang,tgt_lang; tùy adapter; restart.
MT_EN_VI_ADAPTER_KWARGS_JSON={}
# Prefix văn bản đầu vào cho seq2seq, ví dụ translate English to Vietnamese: ; theo model card; restart.
MT_EN_VI_PREFIX=
# Nguồn mock|hf_hub|hf_remote|local; mock chỉ minh họa; restart.
