APP_NAME=DeepVoice
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Docker dùng mongo; local dùng mongodb://localhost:27017
# Đặt disabled để chạy local không cần MongoDB; dữ liệu khi đó chỉ nằm trong RAM.
MONGODB_URL=disabled
MONGODB_DATABASE=deepvoice
# mock | huggingface | local
ASR_PROVIDER=huggingface
# Tên hiển thị và log của ASR model
ASR_MODEL_NAME=duyhocfpt/whisper-small-ami-ihm
# Hugging Face model ID, chỉ dùng khi provider=huggingface
ASR_MODEL_ID=duyhocfpt/whisper-small-ami-ihm
# Đường dẫn model local, chỉ dùng khi provider=local
ASR_MODEL_PATH=
# auto | cpu | cuda
ASR_DEVICE=auto
# Sample rate audio đầu vào
ASR_SAMPLE_RATE=16000
ASR_LANGUAGE=en
ASR_TASK=transcribe
ASR_CHUNK_SECONDS=25
ASR_MAX_NEW_TOKENS=440
# mock | huggingface | local
MT_PROVIDER=huggingface
MT_MODEL_NAME=VietAI/envit5-translation
MT_MODEL_ID=VietAI/envit5-translation
MT_DEVICE=auto
MT_SOURCE_LANGUAGE=en
MT_TARGET_LANGUAGE=vi
# Số từ tối đa mỗi chunk dịch.
MT_MAX_CHUNK_WORDS=25
# Số chunk dịch trong một batch.
MT_BATCH_SIZE=8
# Số beam khi generate.
MT_NUM_BEAMS=4
# Kích thước n-gram không được lặp lại.
MT_NO_REPEAT_NGRAM=3
# Hệ số phạt lặp.
MT_REPETITION_PENALTY=1.2
# Số token mới tối đa cho mỗi chunk.
MT_MAX_NEW_TOKENS=128
# Khôi phục dấu câu bằng model phụ trợ (mặc định tắt).
MT_RESTORE_PUNCTUATION=false
# JWT secret, bắt buộc đổi trước production
# JWT secret, bắt buộc đổi trước production
JWT_SECRET=change-me-in-development
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
MAX_AUDIO_MB=25
MAX_AUDIO_SECONDS=600
# Payment provider: mock | bank_qr | google_pay
PAYMENT_PROVIDER=mock
BANK_CODE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
PAYMENT_QR_TEMPLATE=compact2
